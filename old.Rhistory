L <- generate_similarity_bixi()
L <- generate_similarity_bixi("0.6", "25Sep")
L <- generate_similarity_bixi(0.6, "25Sep")
L$spatial
s1 <- base::svd(L$spatial)
s2 <- IMR::opt_svd(L$spatial, tol=1e-4)
s2$d
s1$d
s1$v * s1$d
#==============================================================================
unsvd <- function(a) tcrossprod(a$u %*% diag(a$d), a$v )
all.equal(unsvd(s1), L$spatial)
all.equal(unsvd(s1), unsvd(s2))
all.equal(unsvd(s1), unsvd(s2), tolerance = 1e-4)
unsvd(s2)
unsvd(s1)
all.equal(unsvd(s1), unsvd(s2), tolerance = 1e-6)
unsvdInv  <- function(a) tcrossprod(a$u %*% diag(1/a$d), a$v )
all.equal(solve(L$spatial), unsvdInv(s1))
all.equal(solve(L$spatial), unsvdInv(s1), tolerance=1e-6)
all.equal(solve(L$spatial), unsvdInv(s1), tolerance=1e-4)
all.equal(solve(L$spatial), unsvdInv(s1), tolerance=1e-5)
all.equal(solve(L$spatial), unsvdInv(s1), tolerance=1e-4)
unsvdInv(s1)
solve(L$spatial)
round(solve(L$spatial),4)
