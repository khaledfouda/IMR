round(unsvdInv(s2),4)[1:5,1:6]
trimm <- function(a, tol=1e-6) {
idx <- which(a$d < 1e-6)
return(list(
u = a$u[, idx, drop = FALSE],
d = a$d[idx],
v = a$v[, idx, drop = FALSE]
))
}
all.equal(unsvd(s1), unsvd(trimm(s1)))
all.equal(unsvd(s1), unsvd(trimm(s1)), tolerance=1e-6)
a <- s1
idx <- which(a$d < tol)
idx
trimm <- function(a, tol=1e-6) {
idx <- which(a$d > tol)
return(list(
u = a$u[, idx, drop = FALSE],
d = a$d[idx],
v = a$v[, idx, drop = FALSE]
))
}
all.equal(unsvd(s1), unsvd(trimm(s1)), tolerance=1e-6)
all.equal(solve(L$spatial), unsvdInv(s1), tolerance=1e-4)
all.equal(solve(L$spatial), unsvdInv(trimm(s1)), tolerance=1e-4)
